  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:migrate": "dotenv -e .env.local -- bash scripts/apply-custom-migrations.sh",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "verify-chain": "dotenv -e .env.local -- tsx scripts/verify-chain.ts",
    "run-eval": "dotenv -e .env.local -- tsx scripts/run-eval.ts",
    "test": "dotenv -e .env.local -- vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.41",
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.7.4",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.6.0",
    "ai": "^7.0.64",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
